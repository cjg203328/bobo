# Copy to .env.cloud and set a unique URL-safe random password before starting the cloud stack.
# Generate a value with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-secret
CANVAS_AUTH_COOKIE_SECURE=false
CANVAS_CORS_ORIGINS=http://localhost:1010
CANVAS_WEB_HOST_PORT=1010
CANVAS_AUTO_MIGRATE=true
